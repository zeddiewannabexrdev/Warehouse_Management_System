{
  "name": "distributed-wms-backend",
  "version": "1.0.0",
  "description": "Backend API Foundation for Distributed Materials & WMS with MongoDB Sharded Cluster",
  "author": "Distributed Database WMS Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "test:stock-movements": "node --test --require ts-node/register test/stock-movements.test.ts",
