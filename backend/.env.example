# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Sharded Cluster Connection (Mongos Router)
MONGODB_URI=mongodb://localhost:27017/material_inventory_db
DATABASE_NAME=material_inventory_db

# Security & Authentication
JWT_SECRET=distributed_wms_secret_key_change_in_production_2026
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=distributed_wms_refresh_secret_key_2026
JWT_REFRESH_EXPIRATION=7d

# Initial Admin Seed (Only used on empty users collection)
ADMIN_DEFAULT_EMAIL=admin@wms.enterprise.vn
ADMIN_DEFAULT_PASSWORD=Admin@Distributed2026
